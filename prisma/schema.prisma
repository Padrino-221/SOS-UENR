generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ProgrammeLevel {
  DIPLOMA
  DEGREE
  POSTGRADUATE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts        Post[]
  pages        Page[]
  @@map("users")
}

model Department {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shortName   String?
  summary     String
  description String   @default("")
  icon        String?
  imageUrl    String?
  ordering    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programmes  Programme[]
  staff       Staff[]
  projects    Project[]
  @@map("departments")
}

model Programme {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  code        String?
  level       ProgrammeLevel @default(DEGREE)
  mode        String? // e.g. "Regular / Weekend"
  duration    String? // e.g. "4 Years"
  summary     String
  overview    String         @default("")
  requirements String        @default("")
  careerPaths String         @default("")
  imageUrl    String?
  published   Boolean        @default(true)
  ordering    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  @@map("programmes")
}

enum PostCategory {
  NEWS
  ANNOUNCEMENT
  EVENT
}

enum StaffType {
  LECTURER
  REGISTRAR
  ADMINISTRATOR
}

enum DegreeLevel {
  BSc
  Diploma
  MSc
  MPHIL
  PHD
}

model Post {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  category    PostCategory @default(NEWS)
  excerpt     String       @default("")
  content     String       @default("")
  coverImage  String?
  published   Boolean      @default(true)
  featured    Boolean      @default(false)
  publishedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  authorId    String?
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  @@index([category, published])
  @@map("posts")
}

model Staff {
  id         String   @id @default(cuid())
  name       String
  title      String? // designation/rank
  email      String?
  phone      String?
  bio        String   @default("")
  researchAreas String @default("")
  photoUrl   String?
  roles      String? // comma-separated e.g. "Dean, Professor"
  staffType  StaffType @default(LECTURER)
  spmsAccess Boolean  @default(false)
  spmsPasswordChanged Boolean @default(false)
  spmsResetToken      String?
  spmsResetExpiry     DateTime?
  passwordHash        String?
  ordering   Int      @default(0)
  showOnPublic Boolean @default(true)
  isExecutive Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  executiveYearId String?
  executiveYear   AcademicYear? @relation("StaffExecutiveYear", fields: [executiveYearId], references: [id], onDelete: SetNull)
  projects     Project[]
  @@map("staff")
}

model ResearchArea {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String
  content   String   @default("")
  imageUrl  String?
  published Boolean  @default(true)
  ordering  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("research_areas")
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @default("")
  published Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt

  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  @@map("pages")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
  @@map("contact_messages")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  updatedAt DateTime @updatedAt
  @@map("site_settings")
}

model AcademicYear {
  id        String   @id @default(cuid())
  year      String   @unique // e.g. "2025/2026"
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  projects  Project[]
  executives Staff[] @relation("StaffExecutiveYear")
  @@map("academic_years")
}

model Project {
  id            String      @id @default(cuid())
  slug          String      @unique
  title         String
  abstract      String      @default("")
  objective     String      @default("")
  studentName   String?
  groupMembers  String?     // comma-separated
  programme     String?     // e.g. "BSc Computer Science"
  degreeLevel   DegreeLevel @default(BSc)
  academicYearId String?
  academicYear  AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  supervisorId  String?
  supervisor    Staff?      @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  documentUrl   String?
  documentName  String?
  githubLink    String?
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([departmentId, published])
  @@map("projects")
}
