# Database
DATABASE_URL="postgresql://user:password@localhost:5432/school_sciences?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin bootstrap (used only when ADMIN_BOOTSTRAP=true for initial setup)
ADMIN_BOOTSTRAP="false"
ADMIN_EMAIL="admin@sciences.uenr.edu.gh"
ADMIN_PASSWORD="ChangeMe123!"

# Session — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 chars, unique per environment
AUTH_SECRET="replace-with-a-strong-random-32-char-secret"

# Email (Resend)
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="School of Sciences <noreply@sciences.uenr.edu.gh>"

# Uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
